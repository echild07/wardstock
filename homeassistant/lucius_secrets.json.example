{
  "_comment": "Copy this to /share/lucius_secrets.json on your HA box (use /share specifically, not /config -- the Node-RED add-on's own /config is a different directory than HA's real config, see README.md step 4). Fill in every value below. Never commit the real file anywhere, never paste it into a chat, never leave it in Node-RED's flow JSON itself (PLAN.md \u00a73).",

  "godaddy_base_url": "https://emperorschildren.net/Wardstock",
  "godaddy_api_sync_token": "PASTE THE VALUE OF API_SYNC_TOKEN FROM godaddy/config/config.php HERE - MUST MATCH EXACTLY",

  "_oura_client_note": "oura_client_id/oura_client_secret are DELIBERATELY NOT stored here anymore (PLAN.md §3, decided) - GoDaddy's config.php is now the source of truth for both, fetched live by the Oura Sync flow each run via api/get_shared_config.php using godaddy_api_sync_token above. Nothing to fill in for either.",
  "oura_access_token": "leave blank initially - see setup step 3 in README.md, this gets populated after the first manual OAuth authorization",
  "oura_refresh_token": "leave blank initially - same as above",
  "oura_expires_at": "leave blank initially - same as above, an ISO timestamp gets written here automatically after first auth",

  "influxdb_url": "http://a0d7b954-influxdb:8086",
  "_influxdb_url_note": "confirmed working via curl from Node-RED's exec node (HTTP 200). Both this hostname AND http://localhost:8086 worked in testing - this one was chosen deliberately: it's the actual Supervisor-managed Docker hostname for the InfluxDB add-on, not dependent on that add-on happening to be in host-networking mode (which is what makes localhost work, and could change). If a0d7b954-influxdb doesn't work on your setup, check the InfluxDB add-on's Info tab for the real hostname, or fall back to localhost:8086 if that's confirmed reachable instead.",
  "influxdb_org": "your influxdb org name",
  "influxdb_bucket": "lucius",
  "influxdb_token": "an InfluxDB API token with write access to that bucket - create one in InfluxDB's UI under Data > API Tokens"
}
